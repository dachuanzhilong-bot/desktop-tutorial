# Cloud sync (optional). Create a Supabase project, run supabase/schema.sql in its SQL editor,
# enable the Email provider (and put {{ .Token }} in the Magic Link e-mail template), then copy the
# project URL and the public anon key here and rebuild. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
